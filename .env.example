# Copiar a .env y completar. Nunca commitear .env.
# Las rutas relativas se toman desde la raíz del repo.

# --- Obligatorias fuera del modo mock ---
ANTHROPIC_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
ARCA_CUIT=
ARCA_CERT_PATH=certs/arca.crt
ARCA_KEY_PATH=certs/arca.key

# --- Opcionales ---
# PORT=3000
# DATABASE_PATH=data/aldebaran.db
# Procesos automáticos (facturación y casilla). Solo corren con true; en desarrollo dejarlo apagado.
# SCHEDULER_ENABLED=false
# Solo desarrollo: redirige todos los emails a esta casilla.
# EMAIL_REDIRECT_TO=
# Con true simula ARCA, el LLM y el email (ver "Modo mock" en PRD.md).
# En modo mock no hace falta ninguna otra variable y se usa data/aldebaran-mock.db.
# MOCK_MODE=false
