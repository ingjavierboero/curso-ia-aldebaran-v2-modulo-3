{
  "name": "aldebaran",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w server",
    "dev:mock": "MOCK_MODE=true npm run dev",
    "db:reset:mock": "rm -f data/aldebaran-mock.db data/aldebaran-mock.db-wal data/aldebaran-mock.db-shm",
    "exchange:check": "npm run exchange:check -w server",
    "arca:check": "npm run arca:check -w server --",
    "billing:run": "npm run billing:run -w server --",
    "email:check": "npm run email:check -w server --",
    "mailbox:check": "npm run mailbox:check -w server --",
    "mailbox:run": "npm run mailbox:run -w server --"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
