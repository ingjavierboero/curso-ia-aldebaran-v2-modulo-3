{
  "name": "@aldebaran/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "exchange:check": "tsx src/exchange/check.ts",
    "arca:check": "tsx src/arca/check.ts",
    "billing:run": "tsx src/billing/run.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
